// Bubblewrap Sandbox Launcher Configuration File
{
  "system": {
    "share_net": true,
    "clearenv": true,
    "unshare_uts": true,
    "hostname": "bubble"
  },
  "sandbox_path": "",
  "models_json_path": "",
  "tmux_session_name": "bwrap-dev",
  "max_file_count": 1000,
  "profiles": [
    "editor",
    "no-history"
  ],
  // Features are enabled by default. Uncomment to disable:
  // "features": {
  //   "enable_ssh": false,
  //   "enable_x11": false,
  //   "enable_wsl": false
  // },
  "pass_env": [
    "USER",
    "LOGNAME",
    "SHELL",
    "TERM",
    "LANG",
    "LC_ALL"
  ],
  "env": {
    "HOME": "/home/sariel",
    "EDITOR": "emacs -nw",
    "VISUAL": "$EDITOR"
  },
  "path": [
    "/home/sariel/bin",
    "/home/sariel/.local/bin",
    "/usr/bin",
    "/sbin",
    "/bin"
  ],
  "binds_rw": [
    ["~/.opencode", "/home/sariel/.opencode"],
    ["~/.terminfo", "/home/sariel/.terminfo"],
    ["~/.local/share/terminfo", "/home/sariel/.local/share/terminfo"]
  ],
  "binds_ro": [
    ["/bin", "/bin"],
    ["/usr", "/usr"],
    ["/lib", "/lib"],
    ["/lib64", "/lib64"],
    ["/lib32", "/lib32"],
    ["/libx32", "/libx32"],
    ["/sbin", "/sbin"],
    ["/run/systemd/journal", "/run/systemd/journal"],
    ["~/.local/bin", "/home/sariel/.local/bin"],
    ["~/.local/lib", "/home/sariel/.local/lib"],
    ["~/.local/share/uv", "/home/sariel/.local/share/uv"],
    ["~/.local/share/pipx", "/home/sariel/.local/share/pipx"],
    ["~/.gitconfig", "/home/sariel/.gitconfig"],
    ["~/.config/git", "/home/sariel/.config/git"],
    ["~/.ssh/config", "/home/sariel/.ssh/config"],
    ["~/.ssh/known_hosts", "/home/sariel/.ssh/known_hosts"],"/home/sariel/papers/bib/","/home/sariel/papers/bib/"
  ]
}
