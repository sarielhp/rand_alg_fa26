#!/usr/bin/env ruby
# frozen_string_literal: true

require "etc"
require "fileutils"
require "open3"
require "optparse"
require "time"

TOOLS_DIR = File.expand_path(__dir__)
ROOT_DIR  = File.expand_path("..", TOOLS_DIR)
BOOK_TEX  = File.join(ROOT_DIR, "book.tex")

# Environment variables to neutralize to prevent leakage from user environment
LATEX_ENV_VARS = %w[
  BIBINPUTS
  BSTINPUTS
  TEXINPUTS
  PDFTEXINPUTS
  XETEXINPUTS
  LUATEXINPUTS
  LUAINPUTS
  BBLINPUTS
  TEXMFOUTPUT
  TEXFORMATS
  TEXFONTS
  TFMFONTS
  T1FONTS
  OFMFONTS
  AFMFONTS
  TTFONTS
  OPENTYPEFONTS
  MFINPUTS
  MPINPUTS
  TEXPICTS
  TEXDOCS
  TEXSOURCES
  TEXPOOL
  INDEXSTYLE
  BIBTEX_PREFIX
  LATEXOPTS
  LATEXOPTIONS
  PDFBIN
  PDFBINONLY
  LATEX_ENGINE
  TEXMFHOME
  TEXMFCNF
  TEXMFCONFIG
  TEXMFVAR
  TEXMFCACHE
].freeze

def sanitize_environment!
  wiped = []
  LATEX_ENV_VARS.each do |var|
    if ENV.key?(var)
      wiped << "#{var}=#{ENV[var]}"
      ENV.delete(var)
    end
  end
  ENV.keys.each do |key|
    if key =~ /\A(?:TEX|BIB|BST|LUA|MF|MP)INPUTS/i || key =~ /\ATEXMF/i
      wiped << "#{key}=#{ENV[key]}" unless wiped.any? { |w| w.start_with?("#{key}=") }
      ENV.delete(key)
    end
  end
  wiped
end

def spawn_env_hash
  hash = LATEX_ENV_VARS.each_with_object({}) { |v, h| h[v] = nil }
  ENV.keys.each do |k|
    hash[k] = nil if k =~ /\A(?:TEX|BIB|BST|LUA|MF|MP)INPUTS/i || k =~ /\ATEXMF/i
  end
  hash
end

def verify_sanitization!(clean_env)
  probe_keys = %w[TEXINPUTS BIBINPUTS BSTINPUTS TEXMFHOME TEXMFCNF]
  probe_cmd = probe_keys.map { |k| "#{k}:[$#{k}]" }.join(" ")
  out, _, st = Open3.capture3(clean_env, "bash", "-c", "echo #{probe_cmd}")
  expected = probe_keys.map { |k| "#{k}:[]" }.join(" ")
  unless st.success? && out.strip == expected
    warn "ERROR: Environment variable sanitation verification failed! Got: #{out.strip}"
    exit 1
  end
  true
end

def parse_chapters
  chapters = []
  if File.exist?(BOOK_TEX)
    File.foreach(BOOK_TEX) do |line|
      if line =~ /^\s*\\InputChap\{([^}]+)\}\s*\{([^}]+)\}/
        chapters << { dir: $1.strip, file: $2.strip }
      end
    end
  end

  # Fallback / augment with any numbered chapter directories missing from book.tex
  known_dirs = chapters.map { |c| c[:dir] }
  Dir.glob(File.join(ROOT_DIR, "[0-9][0-9]_*")).sort.each do |dir_path|
    dir_name = File.basename(dir_path)
    next if known_dirs.include?(dir_name)

    # Pick matching .tex file if exists
    tex_candidates = Dir.glob(File.join(dir_path, "*.tex")).reject { |f| f.end_with?(".bak.tex") }
    main_candidate = tex_candidates.find { |f| File.basename(f, ".tex") == dir_name.sub(/^\d+_/, "") } || tex_candidates.first
    if main_candidate
      chapters << { dir: dir_name, file: File.basename(main_candidate) }
    end
  end

  chapters
end

def filter_chapters(chapters, filters)
  return chapters if filters.empty?

  chapters.select do |chap|
    filters.any? do |f|
      chap[:dir].include?(f) || chap[:file].include?(f)
    end
  end
end

def build_l_command(chap, options)
  cmd = ["l"]
  cmd << "--no-env" if options[:no_env]
  cmd << "--no-bib" if options[:no_bib]
  cmd << "-s" unless options[:verbose]
  cmd << "-u" if options[:quick]
  cmd << "--fast" if options[:fast]
  cmd << "-d" if options[:diff]
  cmd += ["-e", options[:engine]] if options[:engine]
  cmd << chap[:file]
  cmd
end

def format_bytes(bytes)
  return "0 B" unless bytes && bytes.positive?

  if bytes < 1024
    "#{bytes} B"
  elsif bytes < 1024 * 1024
    format("%.1f KB", bytes / 1024.0)
  else
    format("%.2f MB", bytes / (1024.0 * 1024.0))
  end
end

def compile_chapter(chap, options, clean_env)
  chap_dir = File.join(ROOT_DIR, chap[:dir])
  tex_file = chap[:file]

  return { success: false, error: "Directory #{chap[:dir]} not found", elapsed: 0.0 } unless Dir.exist?(chap_dir)

  tex_path = File.join(chap_dir, tex_file)
  return { success: false, error: "File #{tex_path} not found", elapsed: 0.0 } unless File.exist?(tex_path)

  base_name = File.basename(tex_file, ".tex")
  expected_pdf = File.join(chap_dir, "#{base_name}.pdf")

  cmd = build_l_command(chap, options)
  t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  spawn_args = options[:no_env] ? [clean_env, *cmd] : [*cmd]
  stdout, stderr, status = Open3.capture3(*spawn_args, chdir: chap_dir)
  elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0

  errors = 0
  warnings = 0
  if stdout =~ /Errors:\s*(\d+)/i
    errors = $1.to_i
    warnings = $1.to_i if stdout =~ /Warnings:\s*(\d+)/i
  end

  pdf_exists = File.exist?(expected_pdf)
  pdf_size = pdf_exists ? File.size(expected_pdf) : 0

  success = status.success? && errors.zero? && pdf_exists && pdf_size.positive?

  # Automatic fallback: if compilation failed because of an empty bibliography (no citations),
  # retry with --no-bib to allow l to cleanly produce the PDF.
  if !success && !options[:no_bib]
    err_bib = File.join(chap_dir, "junk", "err_bib")
    junk_pdf = File.join(chap_dir, "junk", "#{base_name}.pdf")
    is_bib_failure = (File.exist?(err_bib) && File.size?(err_bib)) ||
                     (File.exist?(junk_pdf) && File.size?(junk_pdf)) ||
                     stdout =~ /Empty bibliography/i ||
                     stdout =~ /Bibliography process failed/i

    if is_bib_failure
      retry_cmd = build_l_command(chap, options.merge(no_bib: true))
      t0_retry = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      retry_spawn_args = options[:no_env] ? [clean_env, *retry_cmd] : [*retry_cmd]
      stdout, stderr, status = Open3.capture3(*retry_spawn_args, chdir: chap_dir)
      elapsed += Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0_retry

      errors = 0
      warnings = 0
      if stdout =~ /Errors:\s*(\d+)/i
        errors = $1.to_i
        warnings = $1.to_i if stdout =~ /Warnings:\s*(\d+)/i
      end

      pdf_exists = File.exist?(expected_pdf)
      pdf_size = pdf_exists ? File.size(expected_pdf) : 0
      success = status.success? && errors.zero? && pdf_exists && pdf_size.positive?
    end
  end

  err_msg = nil
  unless success
    if !status.success? || errors > 0
      err_msg = errors > 0 ? "#{errors} LaTeX error(s)" : "l exited with code #{status.exitstatus}"
    elsif !pdf_exists || pdf_size.zero?
      err_msg = "Output PDF not generated (#{expected_pdf})"
    end

    # Look for error logs in junk/
    candidate_logs = [
      File.join(chap_dir, "junk", "err_xelatex"),
      File.join(chap_dir, "junk", "err_xelatex_1"),
      File.join(chap_dir, "junk", "err_xelatex_2"),
      File.join(chap_dir, "junk", "err_xelatex_3"),
      File.join(chap_dir, "junk", "err_bib"),
      File.join(chap_dir, "junk", "log.txt")
    ]
    candidate_logs.each do |log_f|
      if File.exist?(log_f) && File.size?(log_f)
        tail = File.readlines(log_f).last(15).map(&:chomp).join("\n")
        err_msg += "\n    From #{File.basename(log_f)}:\n    " + tail.gsub("\n", "\n    ")
        break
      end
    end
  end

  {
    success: success,
    exit_code: status.exitstatus,
    errors: errors,
    warnings: warnings,
    pdf_name: "#{base_name}.pdf",
    pdf_path: expected_pdf,
    pdf_size: pdf_size,
    elapsed: elapsed,
    error: err_msg,
    stdout: stdout,
    stderr: stderr
  }
end

def run_suite(chapters, options)
  wiped = options[:no_env] ? sanitize_environment! : []
  clean_env = options[:no_env] ? spawn_env_hash : nil
  verify_sanitization!(clean_env) if options[:no_env]

  puts "=" * 68
  puts "Updating Chapter PDFs in Parallel"
  puts "=" * 68
  puts "Configuration:"
  puts "  - Chapters to process: #{chapters.size}"
  puts "  - Concurrency:         #{options[:jobs]} worker threads"
  mode_desc = options[:quick] ? "single-pass (-u)" : "full multi-pass"
  mode_desc += ", --fast incremental" if options[:fast]
  mode_desc += ", -d diff-only" if options[:diff]
  mode_desc += ", --no-env isolated" if options[:no_env]
  puts "  - Compilation mode:    #{mode_desc}"
  puts "  - Compiler command:    #{build_l_command({ file: '<file>.tex' }, options).join(' ')}"
  if wiped.any?
    puts "  - Neutralized env vars: #{wiped.map { |w| w.split('=').first }.join(', ')}"
  end
  puts "=" * 68
  puts ""

  if options[:dry_run]
    puts "[Dry-run] Would compile the following #{chapters.size} chapters:"
    chapters.each_with_index do |chap, idx|
      puts format("[%2d/%2d] %s/%s -> %s.pdf", idx + 1, chapters.size, chap[:dir], chap[:file], File.basename(chap[:file], ".tex"))
    end
    exit 0
  end

  results = []
  mutex = Mutex.new
  queue = Queue.new
  chapters.each_with_index { |chap, idx| queue << [chap, idx] }

  t_start = Process.clock_gettime(Process::CLOCK_MONOTONIC)

  threads = Array.new(options[:jobs]) do
    Thread.new do
      until queue.empty?
        begin
          chap, idx = queue.pop(true)
        rescue ThreadError
          break
        end

        res = compile_chapter(chap, options, clean_env)
        mutex.synchronize do
          target = "#{chap[:dir]}/#{chap[:file]}"
          time_str = format("[%.1fs]", res[:elapsed])
          if res[:success]
            size_str = format_bytes(res[:pdf_size])
            status_str = format("PASS (%s, %s) %s", res[:pdf_name], size_str, time_str)
          else
            status_str = format("FAIL (%s) %s", res[:error].to_s.lines.first.to_s.strip, time_str)
          end
          puts format("[%2d/%2d] %-38s ... %s", idx + 1, chapters.size, target, status_str)
          results << { chap: chap, res: res, idx: idx }
        end
      end
    end
  end

  threads.each(&:join)
  total_time = Process.clock_gettime(Process::CLOCK_MONOTONIC) - t_start
  results.sort_by! { |r| r[:idx] }

  passed = results.count { |r| r[:res][:success] }
  failed = results.reject { |r| r[:res][:success] }

  puts "\n" + ("=" * 68)
  puts "PDF Generation Summary:"
  puts format("  Total Chapters: %d", chapters.size)
  puts format("  Updated:        %d", passed)
  puts format("  Failed:         %d", failed.size)
  puts format("  Total Time:     %.2fs", total_time)
  puts ("=" * 68)

  if failed.any?
    puts "\nFailed chapters:"
    failed.each do |f|
      puts "  - #{f[:chap][:dir]}/#{f[:chap][:file]}:"
      puts "    #{f[:res][:error]}"
    end
    exit 1
  else
    puts "\nAll #{chapters.size} chapter PDFs updated successfully!"
    exit 0
  end
end

def main
  options = {
    jobs: [Etc.nprocessors, 8].min,
    quick: false,
    fast: false,
    diff: false,
    verbose: false,
    dry_run: false,
    no_env: false,
    engine: nil
  }

  parser = OptionParser.new do |opts|
    opts.banner = "Usage: gen_pdf_all_chapters [options] [chapter_filter ...]"
    opts.separator ""
    opts.separator "Runs 'l' in parallel across all chapter directories to update their standalone PDFs."
    opts.separator ""
    opts.separator "Options:"
    opts.on("-j", "--jobs N", Integer, "Number of parallel workers (default: #{options[:jobs]})") { |v| options[:jobs] = v }
    opts.on("-u", "--quick", "Run single-pass compilation (-u) for fast updates") { options[:quick] = true }
    opts.on("-f", "--full", "Run full multi-pass compilation with bib/biber (default)") { options[:quick] = false }
    opts.on("--fast", "Run 'l --fast' incremental mode") { options[:fast] = true }
    opts.on("-d", "--diff", "Run 'l -d' (only replace target PDF if text changed)") { options[:diff] = true }
    opts.on("--no-env", "Reset LaTeX environment variables (isolated environment)") { options[:no_env] = true }
    opts.on("-e", "--engine ENGINE", String, "LaTeX engine override (passed to l)") { |v| options[:engine] = v }
    opts.on("-v", "--verbose", "Show full compiler output instead of quiet score mode") { options[:verbose] = true }
    opts.on("-n", "--dry-run", "Show what would be compiled without running l") { options[:dry_run] = true }
    opts.on("-h", "--help", "Show this help message") do
      puts opts
      exit 0
    end
  end

  filters = parser.parse(ARGV)
  chapters = filter_chapters(parse_chapters, filters)

  if chapters.empty?
    warn "No matching chapters found."
    exit 1
  end

  run_suite(chapters, options)
end

main if __FILE__ == $PROGRAM_NAME
