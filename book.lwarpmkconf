confversion = [[2]]
opsystem = [[Unix]]
sourcename = [[book]]
homehtmlfilename = [[book]]
htmlfilename = [[]]
imagesdirectory = [[book-images]]
imagesname = [[image-]]
latexmk = [[false]]
printlatexcmd = [[lualatex book]]
HTMLlatexcmd = [[lualatex -interaction=nonstopmode book_html]]
printindexcmd = [[makeindex -s lwarp.ist book.idx]]
HTMLindexcmd = [[makeindex -s lwarp.ist book_html.idx]]
latexmkindexcmd = [[makeindex -s lwarp.ist]]
glossarycmd = [[makeglossaries]]
pdftotextenc = [[UTF-8]]
